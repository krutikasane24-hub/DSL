#include <iostream>
using namespace std;

#define SIZE 10

int hashFunction(int key)
{
    return key % SIZE;
}

void insert(int hashTable[], int key)
{
    int index = hashFunction(key);

    // If position is empty
    if (hashTable[index] == -1)
    {
        hashTable[index] = key;
    }
    else
    {
        // Find next available position
        int i = (index + 1) % SIZE;

        while (hashTable[i] != -1)
        {
            i = (i + 1) % SIZE;
        }

        hashTable[i] = key;
    }
}

void display(int hashTable[])
{
    cout << "\nHash Table:\n";

    for (int i = 0; i < SIZE; i++)
    {
        cout << i << " --> ";

        if (hashTable[i] == -1)
            cout << "EMPTY";
        else
            cout << hashTable[i];

        cout << endl;
    }
}

int main()
{
    int hashTable[SIZE];

    for (int i = 0; i < SIZE; i++)
        hashTable[i] = -1;

    int n, key;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements:\n";

    for (int i = 0; i < n; i++)
    {
        cin >> key;
        insert(hashTable, key);
    }

    display(hashTable);

    return 0;
}